# Database
POSTGRES_DB=taiga
POSTGRES_USER=taiga
POSTGRES_PASSWORD={{ taiga_postgres_password }}

# RabbitMQ
RABBITMQ_USER=taiga
RABBITMQ_PASS={{ taiga_rabbitmq_password }}
RABBITMQ_ERLANG_COOKIE={{ taiga_rabbitmq_erlang_cookie }}
RABBITMQ_VHOST=taiga

# Taiga
SECRET_KEY={{ taiga_secret_key }}
TAIGA_SCHEME=http
TAIGA_DOMAIN={{ tailscale_hostname }}:9000
SUBPATH=

# Email
EMAIL_BACKEND=console
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_DEFAULT_FROM=changeme@example.com
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False

# Attachments
ATTACHMENTS_MAX_AGE=360

# WebSockets
WEBSOCKETS_SCHEME=ws

# Telemetry
ENABLE_TELEMETRY=False
